.animation {
  position: fixed;
  top: 0;
  left: 0;
  height: 100vh;
  display: flex;
  align-items: center;
  white-space: nowrap;
  background-color: #000;
  color: #fff;
  overflow: hidden;
  justify-content: center;
  z-index: 100;
  width: 100%;
}

.animation .animate {
  font-size: 100px;
  font-weight: 400;
  color: #e0e0e0;
  -webkit-animation: animate 10s linear infinite;
  animation: animate 10s linear infinite;
}

@-webkit-keyframes animate {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

@keyframes animate {
  0% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(100%);
  }
}

.animate span {
  -webkit-text-fill-color: transparent;
  -webkit-text-stroke: 1px #00F5FF;
  margin: 0 10px;
}