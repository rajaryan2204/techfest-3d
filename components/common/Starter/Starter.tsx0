import React, { useEffect } from 'react';
import gsap from 'gsap';

import './starter.css';

const Starter = () => {

    useEffect(() => {
        const timeline = gsap.timeline();

        timeline.to(".animate", {
            delay: 3,
            duration: 0.3,
            opacity: 0
        });

        timeline.to(".animation", {
            delay: 1,
            duration: 1,
            y: "100%",
            ease: "power4.out"
        });

        timeline.to(".animation", {
            visibility: "hidden"
        });

        timeline.from(".master", {
            delay: 0.1,
            duration: 0.2,
            opacity: 0,
            stagger: 0.2,
        });

    }, []);

    return (
        <div className='font-normal vipnagorgiallaFont'>
            <div className="animation">
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
                <h1 className="animate">
                    techFEST'26<span>techFEST'26</span>techFEST'26<span>techFEST'26</span>
                </h1>
            </div>
        </div>
    )
}

export default Starter